# ── QAQC Integration (Next.js + Express + MongoDB) ─────────────────────────────
# Copy to backend/.env (backend) and frontend/.env.local (frontend), or keep one .env at the project root.

# Express API
PORT=8001

# MongoDB Community Edition (local)
MONGODB_URI=mongodb://localhost:27017/qaqc

# Signed session cookie secret - set a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
SESSION_MAX_AGE_DAYS=365

# Folder for backups, uploaded files, master-set images and generated Excel files (relative to backend/)
DATA_DIR=./data

# External Schedule Track app: its MongoDB database (read upcoming `records`, write back `records.qaqc`). Blank = integration off.
SCHEDULE_TRACK_MONGODB_URI=mongodb://localhost:27017/schedule_tracker
SCHEDULE_TRACK_RECORDS_COLLECTION=records
# Daily Schedule Track auto-import time (IST, HH:MM)
ST_AUTO_IMPORT_TIME=08:00

# Optional: allow direct browser calls to the API from this origin (normally not needed - Next.js proxies /api)
CORS_ORIGIN=

# Next.js frontend -> where /api/* is proxied to
BACKEND_URL=http://localhost:8001
