{
  "name": "qaqc-backend",
  "version": "2.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx ../database/seed.ts",
    "dev:tsx": "tsx watch src/server.ts"
  },
  "dependencies": {
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "mongoose": "^9.10.3",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
